<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ILXP</AssemblyName>
    <RootNamespace>ILXP</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <ApplicationIcon>..\..\ILXP.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cecil\Mono.Cecil.csproj" />
    <ProjectReference Include="..\Cecil.Pdb\Mono.Cecil.Pdb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\native\**\*">
      <Link>native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png">
      <LogicalName>ILXP.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\TreeIcons.bin">
      <LogicalName>ILXP.Resources.TreeIcons.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\AppIcon.ico">
      <LogicalName>ILXP.Resources.AppIcon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
