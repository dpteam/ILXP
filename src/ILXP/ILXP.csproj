<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ILXP</AssemblyName>
    <RootNamespace>ILXP</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <ApplicationIcon>..\..\ILXP.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Cecil is compiled directly into ILXP.exe, so the build output is a single
      executable. The standalone Cecil projects remain in the solution for reference and
      for the round-trip tests, but ILXP does not reference them.
    -->
    <Compile Include="..\Cecil\**\*.cs" Exclude="..\Cecil\obj\**;..\Cecil\bin\**;..\Cecil\Properties\AssemblyInfo.cs">
      <Link>Cecil\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Cecil.Pdb\**\*.cs" Exclude="..\Cecil.Pdb\obj\**;..\Cecil.Pdb\bin\**;..\Cecil.Pdb\Properties\AssemblyInfo.cs">
      <Link>Cecil.Pdb\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      The native tools are no longer shipped: ILXP uses managed replacements
      (ManagedIlDisassembler, ManagedIlAssembler, ManagedDisassembler, AssemblyResolver).
      "native" is only copied for local experiments and is not part of the build output.
    -->
    <None Include="..\..\native\**\*">
      <Link>native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png">
      <LogicalName>ILXP.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\TreeIcons.bin">
      <LogicalName>ILXP.Resources.TreeIcons.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\AppIcon.ico">
      <LogicalName>ILXP.Resources.AppIcon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Music\Tracks\*.txt">
      <LogicalName>ILXP.Music.Tracks.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
